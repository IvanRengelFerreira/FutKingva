# Copia este archivo como .env (en esta misma carpeta) y rellena los valores.
# El .env no se sube a GitHub: tiene claves personales.

# --- Servidor ---
PORT=3000

# --- Base de datos (PostgreSQL de docker-compose.yml) ---
DATABASE_URL=postgresql://futkingva:futkingva@localhost:5432/futkingva

# --- Sesión ---
# Texto largo y aleatorio. Para generarlo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Fuentes de datos ---
# Token de football-data.org (gratis, registrándose en https://www.football-data.org/client/register)
FOOTBALL_ORG_API=
# Key de API-Football (gratis, registrándose en https://dashboard.api-football.com/register)
API_FOOTBALL=
