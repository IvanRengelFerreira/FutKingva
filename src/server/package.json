{
  "name": "futkingva-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de FutKingva: API REST, base de datos y tiempo real",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:demo": "node seed/demoUsers.js",
    "seed:articles": "node seed/articles.js",
    "import:stats": "node sync/importPlayerStats.js",
    "import:stats:dry": "node sync/importPlayerStats.js --dry-run",
    "import:appearances": "node sync/importAppearances.js",
    "import:appearances:dry": "node sync/importAppearances.js --dry-run",
    "import:referees": "node sync/importReferees.js",
    "import:referees:dry": "node sync/importReferees.js --dry-run",
    "import:photos": "node sync/importPlayerPhotos.js",
    "import:photos:dry": "node sync/importPlayerPhotos.js --dry-run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "pg": "^8.23.1",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
